{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dimer.local/contracts/tabpfn-classifier/artifact-manifest-v1",
  "type":"object","additionalProperties":true,
  "required":["schemaVersion","taskType","targetColumn","featureColumns","fittedEstimator","fittedEstimatorSha256","foundationCheckpoint","foundationCheckpointSha256","portableLoader"],
  "dependentRequired":{"safetensorsWeights":["safetensorsWeightsSha256","safetensorsConversion"]},
  "properties":{
    "schemaVersion":{"const":1},
    "contractVersion":{"type":"integer","minimum":1},
    "taskType":{"const":"tabular_classification"},
    "targetColumn":{"type":"string","minLength":1},
    "featureColumns":{"type":"array","items":{"type":"string"},"minItems":1},
    "classes":{"type":"array","items":{"type":"string"}},
    "fittedEstimator":{"type":"string","minLength":1},
    "fittedEstimatorSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "foundationCheckpoint":{"type":"string","minLength":1},
    "foundationCheckpointSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "portableLoader":{"type":"string","minLength":1},
    "safetensorsWeights":{"const":"model.safetensors"},"safetensorsWeightsSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "safetensorsConversion":{"type":"object","required":["derived_from","tool","toolVersion"],"properties":{
      "derived_from":{"type":"object","required":["file","sha256"],"properties":{"file":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
      "tool":{"type":"string","minLength":1},"toolVersion":{"type":"string","minLength":1},"ser9Clause":{"const":"b"}}}
  }
}
